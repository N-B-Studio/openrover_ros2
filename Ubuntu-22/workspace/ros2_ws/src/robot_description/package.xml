<?xml version="1.0"?>

<package format="3">

  <name>robot_description</name>

  <version>0.0.0</version>

  <description>
    Robot description package for the ROS 2 mobile robot tutorial.
  </description>

  <maintainer email="pleycothh@todo.todo">
    pleycothh
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>
    ament_python
  </buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>
    robot_state_publisher
  </exec_depend>

  <exec_depend>
    joint_state_publisher
  </exec_depend>

  <exec_depend>
    rviz2
  </exec_depend>

  <exec_depend>
    launch
  </exec_depend>

  <exec_depend>
    launch_ros
  </exec_depend>

  <exec_depend>
    ament_index_python
  </exec_depend>

  <!-- Test dependencies -->
  <test_depend>
    ament_copyright
  </test_depend>

  <test_depend>
    ament_flake8
  </test_depend>

  <test_depend>
    ament_pep257
  </test_depend>

  <test_depend>
    python3-pytest
  </test_depend>

  <export>
    <build_type>
      ament_python
    </build_type>
  </export>

</package>